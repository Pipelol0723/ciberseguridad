<mxCell id="n30" value="&lt;b style=&quot;font-size:14px;color:#6C3483&quot;&gt;ZONA DE GESTIÓN&lt;/b&gt;&lt;br&gt;• Fuera de banda (OOB)&lt;br&gt;• SIEM&lt;br&gt;• Bastión / jump host&lt;br&gt;• Gestión de firewalls&lt;br&gt;• Gestión de parches&lt;br&gt;• Backups de configuración" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#6C3483;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontColor=#1B2631;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="280" width="240" height="1100" as="geometry"/></mxCell>
